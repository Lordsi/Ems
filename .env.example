# Employee Management System — Anglican Diocese of Northern Malawi
#
# Copy this file to `.env` for local development:  cp .env.example .env
# Every variable is optional in development; the defaults run against an embedded
# PGlite database in .data/pglite. In production (NODE_ENV=production) the variables
# marked REQUIRED must be set. Never commit a real .env file.
#
# On Render, PORT and RENDER_EXTERNAL_URL are provided by the platform, and render.yaml
# wires NODE_ENV, APP_SECRET (generated) and DATABASE_URL (from the managed database).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# `production` turns on secure cookies, strict configuration checks and the
# DATABASE_URL / APP_SECRET requirements. Leave unset for development.
#NODE_ENV=production

# Listen address. Render sets PORT automatically; keep HOST at 0.0.0.0 on hosted platforms.
PORT=3000
HOST=0.0.0.0

# Express "trust proxy" setting so client IPs and rate limits are correct behind a load
# balancer. Default: `1` in production, `loopback` otherwise.
#TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# REQUIRED in production. PostgreSQL connection string. When unset outside production the
# embedded PGlite database is used instead. Example:
#   postgresql://ems:password@localhost:5432/ems
# TLS is used unless the URL contains sslmode=disable or points at localhost / 127.0.0.1.
#DATABASE_URL=postgresql://ems:password@localhost:5432/ems

# Where the development PGlite database is stored. Delete the folder to start fresh.
PGLITE_DIR=.data/pglite

# Maximum PostgreSQL connections per process (ignored with PGlite).
#DB_POOL_MAX=10

# How long to wait for a PostgreSQL connection before start-up fails with a clear error.
#DB_CONNECT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# REQUIRED in production, at least 32 characters. Encrypts two-factor (TOTP) secrets at rest
# with AES-256-GCM. Rotating it invalidates every existing two-factor enrolment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#APP_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Public base URL used in invitation and notification links. Falls back to
# RENDER_EXTERNAL_URL on Render, then http://localhost:5173 (the Vite dev server).
#APP_URL=https://ems.example.org

# Extra origins allowed to make credentialed API calls, comma separated. Not needed when the
# API serves the built client from the same origin (the default in production).
#CORS_ORIGINS=https://staff.example.org,https://intranet.example.org

# Session lifetimes.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# How long a password re-confirmation stays valid for sensitive actions (approvals,
# payroll changes, account security).
REAUTH_WINDOW_MINUTES=10

# Document upload size limit in bytes (default 5 MiB).
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Scheduled jobs (retirement scan, event reminders, contract expiry and profile notices)
# ---------------------------------------------------------------------------

# Run the jobs inside the web process (default true; tests force false). Set to false when a
# separate cron service runs `npm run jobs:run:prod`, as render.yaml does.
RUN_JOBS_IN_PROCESS=true
JOB_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# One-time super admin bootstrap (hosts without shell access)
# ---------------------------------------------------------------------------

# Honoured only while NO active super admin exists. Set all three (NAME is optional), start
# the app once, then remove them. The account must change its password at first sign-in.
# With shell access prefer:  npm run setup:superadmin -- --email ... --username ... --name "..."
#BOOTSTRAP_SUPERADMIN_EMAIL=admin@northernmalawianglican.org
#BOOTSTRAP_SUPERADMIN_USERNAME=admin
#BOOTSTRAP_SUPERADMIN_PASSWORD=change-me-at-first-login
#BOOTSTRAP_SUPERADMIN_NAME=Diocesan Secretary

# ---------------------------------------------------------------------------
# Script-only variables (not read by the server)
# ---------------------------------------------------------------------------

# `npm run setup:superadmin` reads these when the --email/--username/--name flags are not
# given. SETUP_PASSWORD is used only in non-interactive shells; otherwise it is prompted for.
#SETUP_EMAIL=
#SETUP_USERNAME=
#SETUP_NAME=
#SETUP_PASSWORD=

# `npm run smoke` target and optional sign-in check.
#SMOKE_URL=http://localhost:3000
#SMOKE_USERNAME=
#SMOKE_PASSWORD=
