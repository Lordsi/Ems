{
  "name": "ems",
  "version": "1.0.0",
  "private": true,
  "description": "Employee Management System - secure, role-based employee, payroll and retirement management",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts scripts/setup-superadmin.ts scripts/run-jobs.ts scripts/migrate.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outdir=dist/server --out-extension:.js=.mjs",
    "start": "node dist/server/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:migrate:prod": "node dist/server/scripts/migrate.mjs",
    "setup:superadmin": "tsx --env-file-if-exists=.env scripts/setup-superadmin.ts",
    "setup:superadmin:prod": "node dist/server/scripts/setup-superadmin.mjs",
    "jobs:run": "tsx --env-file-if-exists=.env scripts/run-jobs.ts",
    "jobs:run:prod": "node dist/server/scripts/run-jobs.mjs",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
